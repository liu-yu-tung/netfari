{
  "manifest_version": 3,
  "name": "Netfari",
  "version": "0.2.0",
  "description": "Show a second subtitle language on Netflix and Disney+ in Safari and turn it on or off.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Netfari",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.disneyplus.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "core.js",
        "sites/netflix.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.disneyplus.com/*"
      ],
      "js": [
        "core.js",
        "sites/disney.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core.js",
        "sites/netflix.js",
        "sites/disney.js"
      ],
      "matches": [
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*"
      ]
    }
  ]
}
